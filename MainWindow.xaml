<Window x:Class="NoClickSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="No Click Switch (NCS)"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        HorizontalAlignment="Stretch"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#F2F2F2"
        AllowsTransparency="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseLeave="Window_MouseLeave"
        MouseEnter="Window_MouseEnter">
    <Window.Resources>
        <SolidColorBrush x:Key="TabBgBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="TabBorderBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="TabActiveBgBrush" Color="#D4D4D4" />
        <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#8E8E8E" />
        <SolidColorBrush x:Key="TabHoverBgBrush" Color="#D0E8FF" />
        <SolidColorBrush x:Key="TabHoverBorderBrush" Color="#6BA3D6" />
        <SolidColorBrush x:Key="TabTitleBrush" Color="#444444" />
        <SolidColorBrush x:Key="TabTitleActiveBrush" Color="#222222" />
        <SolidColorBrush x:Key="ChromeIconBrush" Color="#6B6B6B" />
        <SolidColorBrush x:Key="StatLabelBrush" Color="#6B6B6B" />
        <SolidColorBrush x:Key="ClockTimeBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ClockDateBrush" Color="#555555" />

        <!-- Win11 Segoe Fluent Icons (fallback Segoe MDL2 Assets) -->
        <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ChromeIconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FluentIconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeIconBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="ChromeIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="RootPanel" LastChildFill="True" HorizontalAlignment="Stretch">
        <!-- Left: hamburger | Start | Explorer | Terminal -->
        <StackPanel x:Name="LeftChrome"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabHeight}"
                    Margin="6,6,0,0">
            <!-- Hamburger: Settings | Install/Uninstall | app info + links | Close -->
            <Button x:Name="MenuButton"
                    Style="{StaticResource ChromeIconButton}"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0"
                    Click="MenuButton_Click"
                    ToolTip="Menu">
                <Button.ContextMenu>
                    <ContextMenu x:Name="AppMenu"
                                 Opened="AppMenu_Opened">
                        <MenuItem x:Name="MenuSettings"
                                  Header="Settings"
                                  Click="MenuSettings_Click">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE713;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuInstall"
                                  Header="Install"
                                  Click="MenuInstall_Click"
                                  ToolTip="Install for this user and start with Windows login">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE896;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuUninstall"
                                  Header="Uninstall"
                                  Click="MenuUninstall_Click"
                                  ToolTip="Remove auto-start and installed files">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE74D;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuAppName"
                                  Header="No Click Switch (NCS)"
                                  IsEnabled="False">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE946;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuVersion"
                                  Header="1.1.0"
                                  IsEnabled="False" />
                        <MenuItem x:Name="MenuGitHub"
                                  Header="GitHub"
                                  Click="MenuGitHub_Click"
                                  ToolTip="Open the GitHub repository">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE8A7;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuWebsite"
                                  Header="Website"
                                  Click="MenuWebsite_Click"
                                  ToolTip="Open noclickswitch.com">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE774;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuClose"
                                  Header="Close"
                                  Click="MenuClose_Click">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE8BB;" FontSize="16"
                                           VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <!-- GlobalNavButton -->
                <TextBlock Style="{StaticResource ChromeIconText}" Text="&#xE700;" />
            </Button>

            <!-- Start (GoToStart) -->
            <Button x:Name="StartButton"
                    Style="{StaticResource ChromeIconButton}"
                    VerticalAlignment="Center"
                    Margin="2,0"
                    PreviewMouseLeftButtonDown="StartButton_PreviewMouseLeftButtonDown"
                    Click="StartButton_Click"
                    ToolTip="Start">
                <TextBlock Style="{StaticResource ChromeIconText}" Text="&#xE8FC;" />
            </Button>

            <!-- File Explorer (Folder) — Ctrl+click = admin -->
            <Button x:Name="ExplorerButton"
                    Style="{StaticResource ChromeIconButton}"
                    VerticalAlignment="Center"
                    Margin="2,0"
                    Click="ExplorerButton_Click"
                    ToolTip="File Explorer (Ctrl+click = admin)">
                <TextBlock Style="{StaticResource ChromeIconText}" Text="&#xE8B7;" />
            </Button>

            <!-- Windows Terminal (CommandPrompt) — Ctrl+click = admin -->
            <Button x:Name="TerminalButton"
                    Style="{StaticResource ChromeIconButton}"
                    VerticalAlignment="Center"
                    Margin="2,0"
                    Click="TerminalButton_Click"
                    ToolTip="Windows Terminal (Ctrl+click = admin)">
                <TextBlock Style="{StaticResource ChromeIconText}" Text="&#xE756;" />
            </Button>

            <!-- Flameshot addon (Crop) — only visible when installed + enabled in Settings → Addons -->
            <Button x:Name="FlameshotButton"
                    Style="{StaticResource ChromeIconButton}"
                    VerticalAlignment="Center"
                    Margin="2,0"
                    Visibility="Collapsed"
                    Click="FlameshotButton_Click"
                    ToolTip="Flameshot (screenshot)">
                <TextBlock Style="{StaticResource ChromeIconText}" Text="&#xE7A8;" />
            </Button>
        </StackPanel>

        <!--
          Right controls: height matches one tab row and stays on the first row
          (Top + same vertical inset as TabsList/tab margins). Icons centered in that row.
        -->
        <!-- Right: CPU | MEM | HDD | auto-hide | clock -->
        <StackPanel x:Name="RightChrome"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabHeight}"
                    Margin="0,6,6,0">
            <!--
              Compact stats (3 vertical stacks):
              1) CPU% / MEM%
              2) HDD0% / HDD1% (2nd only if present)
              3) CPU°C / GPU°C (GPU only if present)
            -->
            <StackPanel x:Name="StatsHost"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0">
                <!-- Stack 1: CPU + MEM -->
                <Border x:Name="LoadStat"
                        Padding="3,0"
                        Margin="1,0"
                        Background="Transparent"
                        CornerRadius="3"
                        Cursor="Arrow">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="CPU" FontSize="8" Foreground="#6B6B6B" Width="22"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CpuText" Text="--%" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="MEM" FontSize="8" Foreground="#6B6B6B" Width="22"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="MemText" Text="--%" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stack 2: up to 2 fixed disks -->
                <Border x:Name="DiskStat"
                        Padding="3,0"
                        Margin="1,0"
                        Background="Transparent"
                        CornerRadius="3"
                        Cursor="Arrow">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel x:Name="Disk0Row" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="Disk0Label" Text="—" FontSize="8" Foreground="#6B6B6B" Width="16"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Disk0Text" Text="--%" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="Disk1Row" Orientation="Horizontal" HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="Disk1Label" Text="—" FontSize="8" Foreground="#6B6B6B" Width="16"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Disk1Text" Text="--%" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stack 3: temperatures -->
                <Border x:Name="TempStat"
                        Padding="3,0"
                        Margin="1,0"
                        Background="Transparent"
                        CornerRadius="3"
                        Cursor="Arrow">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="CPU" FontSize="8" Foreground="#6B6B6B" Width="22"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CpuTempText" Text="--°" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="GpuTempRow" Orientation="Horizontal" HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                            <TextBlock Text="GPU" FontSize="8" Foreground="#6B6B6B" Width="22"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuTempText" Text="--°" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
              Taskbar auto-hide (Fluent):
              OFF → ChevronDown (taskbar will hide)
              ON  → ChevronUp (taskbar rises on hover)
            -->
            <ToggleButton x:Name="TaskbarAutoHideToggle"
                          VerticalAlignment="Center"
                          Margin="2,0"
                          Width="28"
                          Height="28"
                          Cursor="Hand"
                          Click="TaskbarAutoHideToggle_Click"
                          ToolTip="Toggle Windows taskbar auto-hide"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Width="28"
                                Height="28">
                            <Grid>
                                <TextBlock x:Name="IconDown"
                                           Style="{StaticResource ChromeIconText}"
                                           Text="&#xE70D;" />
                                <TextBlock x:Name="IconUp"
                                           Style="{StaticResource ChromeIconText}"
                                           Text="&#xE70E;"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconDown" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="IconUp" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Clock: time on top, date on bottom (taskbar style) -->
            <Border x:Name="ClockBorder"
                    VerticalAlignment="Center"
                    Margin="4,0,2,0"
                    Padding="6,0"
                    MinWidth="64"
                    Cursor="Arrow"
                    Background="Transparent"
                    CornerRadius="4"
                    ToolTip="">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockTimeText"
                               Text="--:--"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="13"
                               LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="ClockDateText"
                               Text="--/--/----"
                               FontSize="10"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="12"
                               LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Tabs: drag to reorder; wrap with even row gap. Click opens window. -->
        <ItemsControl x:Name="TabsList"
                      Margin="6,6,2,2"
                      AllowDrop="True"
                      DragOver="TabsList_DragOver"
                      Drop="TabsList_Drop"
                      GiveFeedback="TabsList_GiveFeedback"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Horizontal wrap; equal gaps via right+bottom item margins only -->
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <!-- Margin = (0,0,gap,gap): one full gap between neighbors, never half+half -->
                    <Setter Property="Margin" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabItemMargin}" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="TabChrome"
                            Tag="{Binding}"
                            Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabWidth}"
                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabHeight}"
                            Cursor="Arrow"
                            ToolTip="{Binding Title}"
                            CornerRadius="6"
                            Padding="10,0,10,0"
                            AllowDrop="True"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            BorderThickness="1"
                            MouseEnter="Tab_MouseEnter"
                            MouseLeave="Tab_MouseLeave"
                            PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="Tab_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp"
                            DragOver="Tab_DragOver"
                            Drop="Tab_Drop"
                            DragEnter="Tab_DragEnter"
                            DragLeave="Tab_DragLeave">
                        <Border.ContextMenu>
                            <ContextMenu Opened="TabContextMenu_Opened">
                                <MenuItem x:Name="MenuPin"
                                          Header="Pin"
                                          Click="TabPin_Click" />
                                <MenuItem x:Name="MenuMinimize"
                                          Header="Minimize"
                                          Click="TabMinimize_Click" />
                                <Separator />
                                <MenuItem x:Name="MenuCloseTab"
                                          Header="Close"
                                          Click="TabClose_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!--
                          Layers (later triggers win):
                          1) Default light grey
                          2) Active = quieter darker grey
                          3) Hover accent on top
                        -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TabBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource TabBorderBrush}" />
                                <!-- Keep thickness fixed so hover/active never change perceived gap -->
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TabActiveBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TabHoverBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TabHoverBorderBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Pin marker -->
                            <TextBlock Grid.Column="0"
                                       FontFamily="{StaticResource FluentIconFont}"
                                       Text="&#xE718;"
                                       FontSize="10"
                                       Foreground="{DynamicResource TabHoverBorderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       IsHitTestVisible="False"
                                       ToolTip="Pinned">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- App icon or placeholder glyph -->
                            <Grid Grid.Column="1"
                                  Width="16" Height="16"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Aliased">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock FontFamily="{StaticResource FluentIconFont}"
                                           Text="&#xE8A5;"
                                           FontSize="14"
                                           Foreground="{DynamicResource ChromeIconBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       IsHitTestVisible="False"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TabTitleBrush}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TabTitleActiveBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
