<Window x:Class="SwiztchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swiztch Bar"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        HorizontalAlignment="Stretch"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#F2F2F2"
        AllowsTransparency="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
        <!--
          Right controls: height matches one tab row and stays on the first row
          (Top + same vertical inset as TabsList/tab margins). Icons centered in that row.
        -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabHeight}"
                    Margin="0,6,6,0">
            <!-- Taskbar auto-hide -->
            <ToggleButton x:Name="TaskbarAutoHideToggle"
                          VerticalAlignment="Center"
                          Margin="2,0"
                          Width="28"
                          Height="28"
                          Cursor="Hand"
                          Click="TaskbarAutoHideToggle_Click"
                          ToolTip="Toggle Windows taskbar auto-hide"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Width="28"
                                Height="28"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <Grid Width="28" Height="28">
                                <Border x:Name="BarStrip"
                                        Width="16"
                                        Height="3"
                                        CornerRadius="1"
                                        Background="#6B6B6B"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,5" />
                                <Path x:Name="HideChevron"
                                      Data="M 9,14 L 14,10 L 19,14"
                                      Stroke="#6B6B6B"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,4" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0E8FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6BA3D6" />
                                <Setter TargetName="BarStrip" Property="Background" Value="#2F7FD1" />
                                <Setter TargetName="HideChevron" Property="Stroke" Value="#2F7FD1" />
                                <Setter TargetName="HideChevron" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#BFDFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Windows Start (modern 4-square logo) -->
            <Button x:Name="StartButton"
                    VerticalAlignment="Center"
                    Margin="2,0"
                    Width="28"
                    Height="28"
                    Cursor="Hand"
                    Click="StartButton_Click"
                    ToolTip="Start"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Width="28"
                                Height="28">
                            <!-- Modern Windows logo: 2×2 squares with gap -->
                            <Canvas Width="16" Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Rectangle Canvas.Left="0" Canvas.Top="0"
                                           Width="7" Height="7" RadiusX="0.5" RadiusY="0.5"
                                           Fill="#F25022" />
                                <Rectangle Canvas.Left="9" Canvas.Top="0"
                                           Width="7" Height="7" RadiusX="0.5" RadiusY="0.5"
                                           Fill="#7FBA00" />
                                <Rectangle Canvas.Left="0" Canvas.Top="9"
                                           Width="7" Height="7" RadiusX="0.5" RadiusY="0.5"
                                           Fill="#00A4EF" />
                                <Rectangle Canvas.Left="9" Canvas.Top="9"
                                           Width="7" Height="7" RadiusX="0.5" RadiusY="0.5"
                                           Fill="#FFB900" />
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Clock: time on top, date on bottom (taskbar style) -->
            <Border x:Name="ClockBorder"
                    VerticalAlignment="Center"
                    Margin="4,0,2,0"
                    Padding="6,0"
                    MinWidth="64"
                    Cursor="Arrow"
                    Background="Transparent"
                    CornerRadius="4"
                    ToolTip="">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockTimeText"
                               Text="--:--"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="13"
                               LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="ClockDateText"
                               Text="--/--/----"
                               FontSize="10"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="12"
                               LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Border>

            <!-- Close -->
            <Button x:Name="CloseButton"
                    VerticalAlignment="Center"
                    Margin="2,0,2,0"
                    Width="28"
                    Height="28"
                    Cursor="Hand"
                    Click="CloseButton_Click"
                    ToolTip="Close Swiztch Bar"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Width="28"
                                Height="28">
                            <Path Data="M 7,7 L 21,21 M 21,7 L 7,21"
                                  Stroke="#6B6B6B"
                                  StrokeThickness="2.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="28"
                                  Height="28"
                                  Stretch="None" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Tabs: drag to reorder; order is kept across refresh. Click opens window. -->
        <ItemsControl x:Name="TabsList"
                      Margin="4,4,0,4"
                      AllowDrop="True"
                      DragOver="TabsList_DragOver"
                      Drop="TabsList_Drop"
                      GiveFeedback="TabsList_GiveFeedback">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="TabChrome"
                            Tag="{Binding}"
                            Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabWidth}"
                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TabHeight}"
                            Margin="2"
                            Cursor="Arrow"
                            ToolTip="{Binding Title}"
                            BorderBrush="#C8C8C8"
                            BorderThickness="1"
                            Background="#E8E8E8"
                            CornerRadius="4"
                            Padding="4,2"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="Tab_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp"
                            DragOver="Tab_DragOver"
                            Drop="Tab_Drop"
                            DragEnter="Tab_DragEnter"
                            DragLeave="Tab_DragLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="{Binding Icon}"
                                   Width="14"
                                   Height="14"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#333333"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
