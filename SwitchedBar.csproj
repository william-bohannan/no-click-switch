<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SwitchedBar</RootNamespace>
    <AssemblyName>SwitchedBar</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Switched Bar</Product>
    <Company>william-bohannan</Company>
    <Description>Always-on-top Windows top bar window switcher</Description>
    <ApplicationIcon>Assets\SwitchedBar.ico</ApplicationIcon>
    <ApplicationTitle>Switched Bar</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SwitchedBar.ico" />
  </ItemGroup>

</Project>
